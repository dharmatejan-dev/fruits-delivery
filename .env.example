# ==============================================================================
# ORCHARD HARVEST — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Django Settings
SECRET_KEY=orchard-harvest-secret-key-super-secure-production-ready-seed-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database Configuration (PostgreSQL by default; sqlite supported for offline dev/tests)
# PostgreSQL connection format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchard_harvest_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary image storage (create an API key/secret in your Cloudinary console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication (MSG91 OTP)
MSG91_AUTH_KEY=mock_msg91_auth_key_sandbox
MSG91_OTP_TEMPLATE_ID=mock_template_id_sandbox
MSG91_SENDER_ID=ORCHRD

# Firebase Cloud Messaging (leave blank until Firebase project is provisioned)
FIREBASE_CLOUD_PROJECT=
# Set GOOGLE_APPLICATION_CREDENTIALS in the process environment to the
# service-account JSON path, or use Application Default Credentials.

# Online Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=mock_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# JWT Token Lifetimes
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=30
